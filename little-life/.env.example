# LITTLE LIFE — 클라우드 백업 설정
#
# 이 두 줄이 없으면 동기화 기능이 화면에 안 나오고, 앱은 예전처럼
# 폰 안에만 저장한다. 기능을 쓰려면 Supabase 프로젝트를 하나 만들고
# Settings › API 에서 두 값을 복사해 넣는다.
#
# 로컬에서 쓰려면 이 파일을 .env.local 로 복사해서 채운다.
# 배포에 쓰려면 Vercel › Settings › Environment Variables 에 같은 이름으로 넣는다.
#
# anon 키는 공개돼도 되는 키다. 앱 번들에 그대로 들어간다 —
# 대신 supabase/schema.sql 의 RLS 가 남의 기록을 막는다. 꼭 실행할 것.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── 베타: 의견 보낼 곳 ────────────────────────────────
#
# 설정에 "의견 보내기" 한 줄이 뜬다. 오픈카톡 · 구글폼 · 이메일 폼,
# 주소면 뭐든 된다. 이 값이 없으면 그 줄이 아예 안 나온다 —
# 눌러도 아무 데도 안 가는 버튼을 두지 않으려는 것이다.

VITE_FEEDBACK_URL=
