{
  "name": "little-life",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --force",
    "test": "vitest run",
    "assets:extract": "python3 scripts/extract-assets.py",
    "assets:companions": "python3 scripts/extract-companions.py",
    "assets:npcs": "python3 scripts/extract-npc-faces.py",
    "assets:skins": "python3 scripts/extract-skins.py",
    "assets:manifest": "vite-node scripts/build-asset-manifest.ts",
    "assets:thumbs": "python3 scripts/build-thumbs.py",
    "assets:audit": "vite-node scripts/audit-assets.ts",
    "assets:index": "vite-node scripts/build-asset-index.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.9",
    "vitest": "^2.1.9"
  }
}
