# Supabase (없으면 앱은 자동으로 로컬 저장소 모드로 동작합니다)
# Supabase 대시보드 > Project Settings > API 에서 복사
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# anon key 는 브라우저에 노출되는 공개 키입니다.
# 데이터 보호는 RLS(supabase/schema.sql)가 담당하므로 스키마를 반드시 그대로 적용하세요.

# 나만의 발견에 이름을 붙여 주는 endpoint (선택)
# 비워 두면 앱이 만든 문장을 씁니다 — 기능은 그대로 동작합니다.
#
# 여기에 AI API key 를 직접 넣지 마세요. VITE_ 로 시작하는 값은 전부
# 브라우저 번들에 그대로 들어갑니다. key 는 이 endpoint 뒤(서버)에 두세요.
VITE_NAMING_ENDPOINT=
